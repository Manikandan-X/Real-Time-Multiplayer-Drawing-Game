APP_NAME=Real-Time Multiplayer Drawing Game
APP_VERSION=1.0.0
DEBUG=true

# =========================

# MySQL Database

# =========================

MYSQL_DATABASE=drawing_game_db
MYSQL_USER=drawing_game_user
MYSQL_PASSWORD=replace_with_a_strong_password
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password

DB_HOST=mysql
DB_PORT=3306

# =========================

# Database Connection

# =========================

DATABASE_URL=mysql+pymysql://drawing_game_user:replace_with_a_strong_password@mysql:3306/drawing_game_db
